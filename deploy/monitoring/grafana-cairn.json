{
  "title": "Cairn Relay",
  "uid": "cairn-relay",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "relay_connections", "legendFormat": "{{state}}", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Connections opened/closed",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(relay_connections_opened_total[5m])", "legendFormat": "opened/s", "refId": "A" },
        {
          "expr": "rate(relay_connections_closed_total[5m])",
          "legendFormat": "closed/s {{code}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Frames in/out",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "rate(relay_frames_in_total[5m])", "legendFormat": "in/s {{type}}", "refId": "A" },
        { "expr": "rate(relay_frames_out_total[5m])", "legendFormat": "out/s {{type}}", "refId": "B" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Drops by reason",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "rate(relay_frames_dropped_total[5m])", "legendFormat": "{{reason}}", "refId": "A" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Upgrade rejections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "rate(relay_upgrade_rejected_total[5m])", "legendFormat": "{{reason}}", "refId": "A" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Route latency (relay hop)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, rate(relay_route_seconds_bucket[5m]))",
          "legendFormat": "p50 {{path}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, rate(relay_route_seconds_bucket[5m]))",
          "legendFormat": "p99 {{path}}",
          "refId": "B"
        }
      ]
    }
  ]
}
